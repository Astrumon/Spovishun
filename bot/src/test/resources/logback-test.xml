<configuration>
  <!--
    Test-only: keeps the suite quiet. Without any config logback defaults to DEBUG on the console,
    which drowns the test output in the very lines these tests assert on.
  -->
  <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%-5level [chatId=%X{chatId:-system} chatType=%X{chatType:-system}] %logger{36} - %msg%n</pattern>
    </encoder>
  </appender>
  <root level="WARN">
    <appender-ref ref="STDOUT"/>
  </root>
</configuration>
