# Ensure shell scripts always have LF line endings in the repo
gradlew text eol=lf
*.sh text eol=lf

# Normalize line endings for common text files
*.kt text eol=lf
*.kts text eol=lf
*.java text eol=lf
*.xml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.properties text eol=lf
*.toml text eol=lf
*.sql text eol=lf

# Binary files — no line ending conversion
*.jar binary
*.class binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary
