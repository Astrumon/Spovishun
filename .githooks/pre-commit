#!/bin/sh
# Pre-commit hook: run ktlint over the STAGED Kotlin files only.
#
# Behaviour:
#   - auto-fixes everything ktlint can fix and re-stages those files;
#   - BLOCKS the commit (exit 1) on anything ktlint cannot fix automatically
#     (e.g. wildcard imports), printing each problem as file:line in the console.
#
# This hook is version-controlled. Enable it once per clone:
#   git config core.hooksPath .githooks
set +e

# Staged, non-deleted *.kt / *.kts files.
CHANGED_FILES="$(git --no-pager diff --name-status --no-color --cached | awk '$1 != "D" && $NF ~ /\.kts?$/ { print $NF }')"

if [ -z "$CHANGED_FILES" ]; then
    exit 0
fi

echo "[ktlint] checking staged Kotlin files:"
echo "$CHANGED_FILES" | sed 's/^/  - /'

# Temporarily revert unstaged changes so ktlint only sees the staged content.
diff=.git/unstaged-ktlint-git-hook.diff
git diff --binary --color=never > "$diff"
if [ -s "$diff" ]; then
  git apply -R "$diff"
fi

# Format only the staged files. No --quiet, so violations print to the console.
./gradlew ktlintFormat -PinternalKtlintGitFilter="$CHANGED_FILES" --console=plain
gradle_command_exit_code=$?

# Re-stage any files ktlint auto-fixed.
echo "$CHANGED_FILES" | while read -r file; do
    if [ -f "$file" ]; then
        git add "$file"
    fi
done

# Restore the previously unstaged changes.
if [ -s "$diff" ]; then
  git apply --ignore-whitespace "$diff"
fi
rm -f "$diff"
unset diff

if [ "$gradle_command_exit_code" -ne 0 ]; then
    echo ""
    echo "[ktlint] COMMIT BLOCKED — the violations above could not be auto-fixed."
    echo "[ktlint] Fix them at the file:line shown, then 'git add' and commit again."
    exit 1
fi

echo "[ktlint] OK — staged Kotlin files are clean."
exit 0
