# ===========================
# E2E Test Configuration
# ===========================
# Bot under test
TEST_BOT_TOKEN=your_test_bot_token_here

# Helper bot that sends commands to the bot under test
TEST_HELPER_BOT_TOKEN=your_helper_bot_token_here

# Telegram chat ID where the e2e tests run
TEST_CHAT_ID=-1001234567890

# ===========================
# Dev DB (optional)
# ===========================
# Required only for DB-backed e2e tests (BaseE2EDbTest subclasses).
# MUST point to a local dev database — never production.
# If unset, DB e2e tests are skipped automatically.
E2E_DATABASE_URL=jdbc:postgresql://localhost:5432/spovishun
E2E_DATABASE_DRIVER=org.postgresql.Driver
E2E_DATABASE_USERNAME=postgres
E2E_DATABASE_PASSWORD=your_password_here
