# ===========================
# Test database — shared by integrationTest and e2eTest
# ===========================
# Read by IntegrationDbConfig and E2EDbConfig, both of which load `.env.e2e` by name.
# The Telegram-side variables (TEST_BOT_TOKEN / TEST_HELPER_BOT_TOKEN / TEST_CHAT_ID) do NOT
# belong here — E2EConfig reads the default `.env`. See `.env.example`.
#
# MUST point to a local database — never production. TestDatabaseFactory opens with
# flyway.clean(), which drops the schema, and TestDatabaseCleaner refuses any non-loopback host.
#
# If E2E_DATABASE_URL is unset, both source sets skip themselves via assumeTrue.
E2E_DATABASE_URL=jdbc:postgresql://localhost:5432/spovishun_e2e
E2E_DATABASE_DRIVER=org.postgresql.Driver
E2E_DATABASE_USERNAME=postgres
E2E_DATABASE_PASSWORD=your_password_here
E2E_DATABASE_POOL_SIZE=2
