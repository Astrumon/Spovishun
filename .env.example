# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Anti-piracy: bot identity lock — set to your bot's @username (without @)
# If unset, identity check is skipped (warning logged). Required in production.
EXPECTED_BOT_USERNAME=

# Anti-piracy: chat allowlist — comma-separated chat IDs the bot will respond to
# Empty = allowlist disabled (bot accepts all chats). Set in production.
ALLOWED_CHAT_IDS=

# Environment Profile (dev/prod)
# Set via Gradle (runDev/runProd) or manually here for IDE runs
PROFILE=dev

# --- Dev: Local PostgreSQL ---
# IDE / local run: use localhost
# Docker Compose: URL is overridden automatically to jdbc:postgresql://postgres:5432/spovishun_dev
DEV_DATABASE_URL=jdbc:postgresql://localhost:5432/spovishun_dev
DEV_DATABASE_DRIVER=org.postgresql.Driver
DEV_DATABASE_USERNAME=postgres
DEV_DATABASE_PASSWORD=your_password_here
DEV_DATABASE_POOL_SIZE=10
# Used by the postgres Docker container (must match DEV_DATABASE_PASSWORD for dev)
POSTGRES_PASSWORD=your_password_here

# --- Prod: Self-Hosted PostgreSQL (Docker on Oracle Cloud VM) ---
# Local SSH tunnel? jdbc:postgresql://localhost:15432/spovishun_prod
PROD_DATABASE_URL=jdbc:postgresql://postgres:5432/spovishun_prod
PROD_DATABASE_DRIVER=org.postgresql.Driver
PROD_DATABASE_USERNAME=postgres
PROD_DATABASE_PASSWORD=your_secure_password
PROD_DATABASE_POOL_SIZE=10
POSTGRES_DB=spovishun_prod
POSTGRES_USER=postgres
# POSTGRES_PASSWORD already set above — same value for both dev and prod postgres container

# --- Admin API / docker-socket-proxy (prod) ---
# Read-only Docker Engine API exposed by the docker-socket-proxy service.
# Reachable only on the internal proxy-net docker network — never published to a host port.
# Consumed by the future admin-api module (spovishun-110).
DOCKER_API_URL=http://docker-socket-proxy:2375

# Tailscale: install on the prod VM and join the tailnet for private admin access.
# The tailnet IP is recorded out-of-band (e.g. ops notes) — it is not a secret and not read here.

# Notion Integration (for Claude Code skills sync hook)
NOTION_SKILLS_TOKEN=ntn_your_integration_token_here
