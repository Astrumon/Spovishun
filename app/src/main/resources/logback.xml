<configuration>
  <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <!--
        The bracketed chat field sits in a fixed position right after the level so the Spovishun
        Admin live-log view can split it out of the raw Docker line with `\[chatId=(\S+) chatType=(\S+)\]`
        (spovishun-168). `system` is the default for a line with no originating chat — startup,
        shutdown, admin API, a scheduler between per-chat passes.
      -->
      <pattern>%d{yyyy-MM-dd HH:mm:ss} %-5level [chatId=%X{chatId:-system} chatType=%X{chatType:-system}] %logger{36} - %msg%n</pattern>
    </encoder>
  </appender>
  <root level="INFO">
    <appender-ref ref="STDOUT"/>
  </root>
  <logger name="org.jetbrains.exposed" level="WARN"/>
  <logger name="com.zaxxer.hikari" level="WARN"/>
</configuration>
