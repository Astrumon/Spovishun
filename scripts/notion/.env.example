# Notion API token — preferred name (also backward-compat alias used by the hook)
NOTION_SKILLS_TOKEN=ntn_your_integration_token_here

# Notion API token — primary name (checked second in env, first in .env file)
NOTION_TOKEN=ntn_your_integration_token_here

# Provide either NOTION_SKILLS_TOKEN or NOTION_TOKEN. They are equivalent.
# REAL values MUST NOT be committed to git.
# Copy this file to .env and fill in your token.
