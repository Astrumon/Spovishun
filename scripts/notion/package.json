{
  "name": "spovishun-notion",
  "version": "1.0.0",
  "description": "Shared Notion library for Claude Code tooling — scripts + hook",
  "type": "commonjs",
  "scripts": {
    "board": "node get-board.js",
    "task": "node get-task.js",
    "claude-md": "node get-claude-md.js",
    "test": "node --test tests/unit/*.test.js tests/integration/*.test.js tests/fallback/*.test.js",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:integration": "node --test tests/integration/*.test.js",
    "test:fallback": "node --test tests/fallback/*.test.js"
  },
  "engines": {
    "node": ">=18"
  }
}
